# =============================================================================
# HYDROMETEOROLOGY VN ANALYTICS — Environment Configuration Template
# =============================================================================
# Copy file này thành .env và điền các giá trị thực tế trước khi chạy.
# KHÔNG commit file .env thật lên git (đã có trong .gitignore).
# =============================================================================

# --- Supabase Cloud (bắt buộc cho auth + mirror logs) ---
# Lấy tại: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Dùng trong React (phía trình duyệt) — chỉ dùng anon key, KHÔNG dùng service role
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- OpenRouter AI (bắt buộc cho trợ lý AI) ---
# Đăng ký miễn phí tại: https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# Mô hình mặc định (free tier). Thay bằng mô hình khác nếu cần:
#   google/gemini-2.0-flash-exp:free
#   meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- SQLite cục bộ (tự động tạo, không cần chỉnh) ---
DATABASE_URL=sqlite:///./data/ai_logs.db
DB_PATH=./data/ai_logs.db

# --- FastAPI Backend ---
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# --- React Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Tùy chọn: bật đồng bộ logs lên Supabase ---
# Mặc định false — logs chỉ lưu SQLite cục bộ
# ENABLE_SUPABASE_LOGS=false
